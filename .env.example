# Client-side environment key (Flagsmith > Environment Settings > Keys). Safe to expose.
VITE_FLAGSMITH_ENV_KEY=

# Optional, only for self-hosted Flagsmith:
# VITE_FLAGSMITH_API_URL=https://flagsmith.example.com/api/v1/
# VITE_FLAGSMITH_EVENTS_URL=https://flagsmith.example.com/api/

# Optional, only for `npm run setup` (creates the hero_cta flag for you). Keep secret, never commit.
# FLAGSMITH_ADMIN_KEY=
# FLAGSMITH_PROJECT_ID=
# FLAGSMITH_ADMIN_URL=http://localhost:8000/api/v1/

# Simulated click-through rates per variant (used by scripts/simulate.mjs)
SIM_P_CONTROL=0.08
SIM_P_OUTCOME=0.11
